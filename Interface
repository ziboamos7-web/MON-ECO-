import 'package:flutter/material.dart';

void main() {
  runApp(const MonEcoApp());
}

class MonEcoApp extends StatelessWidget {
  const MonEcoApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'MON ECO+',
      theme: ThemeData(
        brightness: Brightness.light,
        primaryColor: const Color(0xFF003366), // Bleu profond
        scaffoldBackgroundColor: const Color(0xFFF8F8F8), // Fond clair
        textTheme: const TextTheme(
          bodyMedium: TextStyle(color: Color(0xFF333333)), // Texte secondaire
        ),
      ),
      darkTheme: ThemeData(
        brightness: Brightness.dark,
        primaryColor: const Color(0xFF5BC85B), // Cercle vert clair
        scaffoldBackgroundColor: const Color(0xFF003366), // Fond sombre
        textTheme: const TextTheme(
          bodyMedium: TextStyle(color: Colors.white),
        ),
      ),
      themeMode: ThemeMode.light, // Peut basculer selon le mode sombre
      home: const SplashScreen(),
    );
  }
}

class SplashScreen extends StatelessWidget {
  const SplashScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final bool isDark = Theme.of(context).brightness == Brightness.dark;

    return Scaffold(
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            // Logo
            CustomPaint(
              size: const Size(150, 150),
              painter: LogoPainter(isDark: isDark),
            ),
            const SizedBox(height: 20),
            // Texte MON ECO+
            RichText(
              text: TextSpan(
                style: TextStyle(
                  fontFamily: 'Montserrat',
                  fontSize: 32,
                  fontWeight: FontWeight.bold,
                  color: isDark ? Colors.white : const Color(0xFF003366),
                ),
                children: [
                  const TextSpan(text: 'MON ECO'),
                  TextSpan(
                    text: '+',
                    style: TextStyle(
                      color: const Color(0xFF28A745), // Vert croissance
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class LogoPainter extends CustomPainter {
  final bool isDark;

  LogoPainter({required this.isDark});

  @override
  void paint(Canvas canvas, Size size) {
    final double strokeWidth = 6;
    final Paint circlePaint = Paint()
      ..color = isDark ? const Color(0xFF5BC85B) : const Color(0xFF003366)
      ..style = PaintingStyle.stroke
      ..strokeWidth = strokeWidth;

    final Paint arrowPaint = Paint()
      ..color = const Color(0xFF28A745)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 8
      ..strokeCap = StrokeCap.round;

    final Paint coinPaint = Paint()
      ..color = isDark ? Colors.white : Colors.white
      ..style = PaintingStyle.fill;

    final double radius = size.width / 2 - strokeWidth;

    // Cercle
    canvas.drawCircle(Offset(size.width / 2, size.height / 2), radius, circlePaint);

    // Pièce stylisée (3 lignes horizontales)
    final double coinWidth = size.width * 0.4;
    final double coinHeight = 4;
    final double spacing = 10;
    for (int i = 0; i < 3; i++) {
      canvas.drawRect(
        Rect.fromCenter(
          center: Offset(size.width / 2, size.height / 2 - spacing + i * spacing),
          width: coinWidth,
          height: coinHeight,
        ),
        coinPaint,
      );
    }

    // Flèche ascendante
    final Path arrowPath = Path();
    arrowPath.moveTo(size.width * 0.2, size.height * 0.75);
    arrowPath.quadraticBezierTo(
        size.width * 0.5, size.height * 0.25, size.width * 0.8, size.height * 0.25);
    canvas.drawPath(arrowPath, arrowPaint);

    // Pointe de flèche
    final Path arrowHead = Path();
    arrowHead.moveTo(size.width * 0.78, size.height * 0.23);
    arrowHead.lineTo(size.width * 0.8, size.height * 0.25);
    arrowHead.lineTo(size.width * 0.82, size.height * 0.23);
    canvas.drawPath(arrowHead, arrowPaint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}
